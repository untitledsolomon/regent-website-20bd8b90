+import { NextResponse } from "next/server";
+import { serviceSupabase } from "@/lib/supabase/service";
+
+export async function GET(req: Request) {
+  const url = new URL(req.url);
+  const limit = Number(url.searchParams.get("limit") || "50");
+  const offset = Number(url.searchParams.get("offset") || "0");
+  const agent_id = url.searchParams.get("agent_id");
+  const tool = url.searchParams.get("tool");
+
+  let query = serviceSupabase.from("mcp_call_log").select(`id, agent_id, tool_name, input_summary, success, error_message, created_at, duration_ms`);
+  if (agent_id) query = query.eq("agent_id", agent_id);
+  if (tool) query = query.eq("tool_name", tool);
+  query = query.order("created_at", { ascending: false }).limit(limit).offset(offset);
+
+  const { data, error } = await query;
+  if (error) return NextResponse.json({ error: error.message }, { status: 500 });
+
+  // Join agent names separately for simplicity
+  const agentIds = Array.from(new Set((data as any[]).map((r) => r.agent_id).filter(Boolean)));
+  let agentsMap: Record<string, string> = {};
+  if (agentIds.length) {
+    const { data: agents } = await serviceSupabase.from("mcp_agents").select("id, name").in("id", agentIds);
+    (agents || []).forEach((a: any) => { agentsMap[a.id] = a.name; });
+  }
+
+  const rows = (data as any[]).map((r) => ({ ...r, agent_name: r.agent_id ? agentsMap[r.agent_id] ?? null : null }));
+
+  return NextResponse.json({ rows });
+}
