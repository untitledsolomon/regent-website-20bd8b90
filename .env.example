# Supabase
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Supabase Edge Function Secrets (set via: supabase secrets set KEY=value)
RESEND_API_KEY=<resend-api-key>
RESEND_AUDIENCE_ID=<resend-audience-id>
NOTIFICATION_EMAIL=<internal-notification-email>

# Regent Growth Engine integration (set in Supabase Edge Function Secrets)
# Enables automatic lead sync: consultations → score 80/90, newsletter → score 40
GROWTH_ENGINE_URL=https://<growth-engine-ref>.supabase.co/functions/v1
GROWTH_ENGINE_AGENT_API_KEY=<agent-api-key-from-growth-engine-secrets>
GROWTH_ENGINE_ORG_ID=<regent-org-uuid-in-growth-engine>
